{
  "zai": {
    "label": "Z.ai (GLM)",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "<z.ai API key>",
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "ANTHROPIC_MODEL": "glm-5.3[1m]",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "glm-5.3[1m]",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3[1m]",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3[1m]",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
      "CLAUDE_CODE_SUBAGENT_MODEL": "glm-5.3[1m]",
      "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
      "API_TIMEOUT_MS": "3000000",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    },
    "modelCatalog": {
      "recognitionOverride": "claude-sonnet-4-6",
      "models": [
        {
          "id": "glm-5.3",
          "name": "GLM-5.3",
          "context_length": 1000000,
          "pricing": { "prompt": "0.0000014", "completion": "0.0000044" }
        },
        {
          "id": "glm-5.3-flash",
          "name": "GLM-5.3-Flash",
          "context_length": 1000000,
          "pricing": { "prompt": "0.000000075", "completion": "0.00000025" }
        },
        {
          "id": "glm-5.2",
          "name": "GLM-5.2",
          "context_length": 1000000,
          "pricing": { "prompt": "0.0000014", "completion": "0.0000044" }
        },
        {
          "id": "glm-5-turbo",
          "name": "GLM-5-Turbo",
          "context_length": 200000
        },
        {
          "id": "glm-4.7",
          "name": "GLM-4.7",
          "context_length": 200000,
          "pricing": { "prompt": "0.0000006", "completion": "0.0000022" }
        }
      ],
      "modelEnv": [
        "ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_FABLE_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "CLAUDE_CODE_SUBAGENT_MODEL"
      ],
      "selectionEnv": {
        "model": "M_SWITCHER_MODEL",
        "context": "M_SWITCHER_CONTEXT_LENGTH",
        "overrideKey": "M_SWITCHER_MODEL_OVERRIDE_KEY",
        "overrideValue": "M_SWITCHER_MODEL_OVERRIDE_VALUE"
      },
      "contextEnv": {
        "max": "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
        "autoCompact": "CLAUDE_CODE_AUTO_COMPACT_WINDOW"
      }
    }
  },
  "kimi": {
    "label": "Kimi Code (k3[1m])",
    "env": {
      "ANTHROPIC_API_KEY": "<kimi code console key>",
      "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
      "ANTHROPIC_MODEL": "k3[1m]",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "k3[1m]",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "k3[1m]",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "k3[1m]",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "k3[1m]",
      "CLAUDE_CODE_SUBAGENT_MODEL": "k3[1m]",
      "CLAUDE_CODE_EFFORT_LEVEL": "high",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1048576",
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576"
    },
    "claudeJson": {
      "penguinModeOrgEnabled": true,
      "hasCompletedOnboarding": true
    }
  },
  "openrouter": {
    "label": "OpenRouter",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "<OpenRouter API key>",
      "ANTHROPIC_API_KEY": "",
      "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
      "ANTHROPIC_MODEL": "~anthropic/claude-sonnet-latest",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "~anthropic/claude-fable-latest",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "~anthropic/claude-opus-latest",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "~anthropic/claude-sonnet-latest",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "~anthropic/claude-haiku-latest",
      "CLAUDE_CODE_SUBAGENT_MODEL": "~anthropic/claude-sonnet-latest",
      "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
      "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
    },
    "modelCatalog": {
      "validationUrl": "https://openrouter.ai/api/v1/key",
      "url": "https://openrouter.ai/api/v1/models?output_modalities=text&supported_parameters=tools&sort=agentic-high-to-low&limit=1000",
      "discountedModelsUrl": "https://openrouter.ai/collections/discounted-models",
      "endpointsUrl": "https://openrouter.ai/api/v1/models",
      "presetsUrl": "https://openrouter.ai/api/v1/presets",
      "recognitionOverride": "claude-sonnet-4-6",
      "excludeIdSuffixes": [
        ":batch"
      ],
      "specialModels": [
        {
          "id": "openrouter/free",
          "name": "OpenRouter: Free Models Router (automatic)",
          "context_length": 200000,
          "pricing": {
            "prompt": "0",
            "completion": "0"
          },
          "direct": true
        }
      ],
      "modelEnv": [
        "ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_FABLE_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "CLAUDE_CODE_SUBAGENT_MODEL"
      ],
      "selectionEnv": {
        "model": "M_SWITCHER_MODEL",
        "endpoint": "M_SWITCHER_ENDPOINT",
        "endpointName": "M_SWITCHER_ENDPOINT_NAME",
        "context": "M_SWITCHER_CONTEXT_LENGTH",
        "overrideKey": "M_SWITCHER_MODEL_OVERRIDE_KEY",
        "overrideValue": "M_SWITCHER_MODEL_OVERRIDE_VALUE"
      },
      "contextEnv": {
        "max": "CLAUDE_CODE_MAX_CONTEXT_TOKENS"
      }
    }
  },
  "aipassport": {
    "label": "AI Passport (qwen3.8-27b)",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "<aipassport API key>",
      "ANTHROPIC_BASE_URL": "https://aipassport.trirat.co",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen3.8-27b",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "qwen3.8-27b",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "qwen3.8-27b",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "qwen3.8-27b",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "230144",
      "API_TIMEOUT_MS": "3000000",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    }
  }
}
